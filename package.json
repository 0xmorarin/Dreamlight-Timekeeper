{
  "name": "dreamlight-timekeeper-sveltekit",
  "private": true,
  "type": "module",
  "version": "0.6.0-migration",
  "scripts": {
    "dev": "node scripts/prepare-worker-gzip-binary.mjs && vite dev",
    "build": "node scripts/prepare-worker-gzip-binary.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs && npm run verify:icons",
    "test:migration": "node --test tests/sveltekit-migration-contract.test.mjs",
    "verify:icons": "node scripts/verify-icon-assets.mjs",
    "test:icon-import": "node --test tests/icon-import.integration.mjs",
    "build:app-icons": "node scripts/build-app-ui-icons.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/node": "^22.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
